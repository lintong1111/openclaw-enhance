{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": [
    "*.ts",
    "../openclaw-tool-factory/*.ts",
    "../openclaw-feature-flag/*.ts",
    "../openclaw-cache-compact/src/*.ts",
    "../openclaw-skill-system/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "example.ts"
  ]
}
